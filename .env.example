# Base URL of the Nexa Gadgets backend API (include the /api suffix)
VITE_API_URL=http://localhost:5000/api

# Paystack PUBLIC key only. The secret key belongs in the backend's env, never here.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: support address shown on the Help pages. Without it, help links use WhatsApp.
VITE_SUPPORT_EMAIL=
